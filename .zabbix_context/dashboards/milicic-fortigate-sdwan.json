        "includeAll": false,
        "hide": 0
      },
      {
        "name": "firewall",
        "label": "Firewall FortiGate",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "efz4nzx8r30g0c"
        },
        "query": {
          "queryType": "2",
          "group": "/(FortiGate|FortiWorld)/",
